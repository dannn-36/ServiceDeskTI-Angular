# Copia este archivo como .env y cambia los valores. El .env está en .gitignore.

# Base de datos
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_USER=servicedesk
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_PUERTO_LOCAL=3307

# Primer administrador (solo se crea si no existe ninguno)
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@servicedesk.local
ADMIN_CONTRASENA=cambia-esta-clave-admin

# Datos de demostración (true/false) y contraseña común de esos usuarios
DATOS_DEMO=true
CONTRASENA_DEMO=Demo12345!

# Puerto local de la aplicación: http://localhost:8080
WEB_PUERTO=8080

# Poner true solo si se sirve por HTTPS (cookie Secure, HSTS)
SOLO_HTTPS=false
